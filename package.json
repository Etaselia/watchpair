{
  "name": "watchpair",
  "version": "0.5.3",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "npm run build:companion",
    "dev": "vinext dev",
    "build": "vinext build",
    "deploy": "vinext deploy",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings=0 --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "agent": "node agent/server.mjs",
    "typecheck": "tsc --noEmit",
    "build:companion": "node scripts/build-companion.mjs",
    "prebuild": "npm run build:companion",
    "test:unit": "node --test tests/hardware-acceleration.test.mjs tests/media-fingerprint.test.mjs tests/torrent-download.test.mjs tests/torrent-runtime.test.mjs tests/wrangler-config.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "drizzle-orm": "0.45.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "webtorrent": "3.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "5.20260723.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "fflate": "^0.8.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "type": "module"
}
