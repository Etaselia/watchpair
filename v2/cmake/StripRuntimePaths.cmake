if(NOT IS_DIRECTORY "${WATCHPAIR_BUNDLE_ROOT}")
  message(FATAL_ERROR "Pass the freshly assembled runtime directory")
endif()
file(GLOB_RECURSE bundle_files LIST_DIRECTORIES false "${WATCHPAIR_BUNDLE_ROOT}/*")
foreach(bundle_file IN LISTS bundle_files)
  file(READ "${bundle_file}" magic LIMIT 4 HEX)
  if(magic STREQUAL "7f454c46")
    file(RPATH_REMOVE FILE "${bundle_file}")
  endif()
endforeach()
