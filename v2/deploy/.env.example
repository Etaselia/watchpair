WATCHPAIR_HOST=watch.example.org
WATCHPAIR_RELAY_HOST=relay.example.org
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
WATCHPAIR_RELAY_SECRET=
# All four ceilings are bytes per second. Zero is unlimited.
WATCHPAIR_RELAY_INGRESS_BPS=10485760
WATCHPAIR_RELAY_EGRESS_BPS=10485760
WATCHPAIR_RELAY_CHANNEL_INGRESS_BPS=5242880
WATCHPAIR_RELAY_CHANNEL_EGRESS_BPS=5242880
